{
  "version": 6,
  "configurePresets": [
    {
      "name": "cspro",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_INSTALL_PREFIX": "$env{CSPRO_DIR}/third_party",
        "CMAKE_INSTALL_INCLUDEDIR": "include"
      }
    },
    {
      "name": "cspro-windows",
      "hidden": true,
      "inherits": [
        "cspro"
      ],
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<IF:$<CONFIG:Debug>,Debug,>DLL"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows (x64)",
      "inherits": [
        "cspro-windows"
      ],
      "binaryDir": "build/windows-x64",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_LIBDIR": "lib/windows-x64",
        "CSPRO_ADDITIONAL_TARGET":  "build-tools"
      }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows (x86)",
      "inherits": [
        "cspro-windows"
      ],
      "binaryDir": "build/windows-x86",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_LIBDIR": "lib/windows-x86"
      }
    },
    {
